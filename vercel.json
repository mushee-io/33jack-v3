{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/approve.js": {
      "maxDuration": 15
    },
    "api/settle.js": {
      "maxDuration": 30
    },
    "api/reconcile.js": {
      "maxDuration": 20
    },
    "api/payments.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/agent.js": {
      "maxDuration": 45
    },
    "api/settlement-network.js": {
      "maxDuration": 15
    },
    "api/v2.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v3/:resource",
      "destination": "/api/v2?resource=:resource"
    },
    {
      "source": "/api/v2/:resource",
      "destination": "/api/v2?resource=:resource"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ]
}
