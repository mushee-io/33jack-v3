# 33JACK V3 — Amadeus TESTNET only (no EVM, no Celo, no mainnet)
AMA_TESTNET_RPC_URL=https://testnet-rpc.ama.one/api
AMA_MAX_PAYMENT_AMOUNT=5
# Public explorer: https://testnet-ama.ddns.net
# User signs in Amadeus Wallet Extension. NEVER add a private key here.

# AI invoice and finance agent (server-side only)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_AGENT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
DATABASE_URL=
APPROVAL_HMAC_SECRET=
PUBLIC_APP_URL=https://YOUR-V3-DEPLOYMENT.vercel.app

# 33JACK owner session, agent and approval policy
JACK_SESSION_SECRET=
JACK_OPERATORS_JSON=
JACK_PRIMARY_WORKSPACE_ID=
JACK_AGENT_API_KEYS_JSON=
JACK_APPROVAL_API_KEY=
JACK_AGENT_TOKEN_SECRET=
JACK_OPERATOR_DB_AUTH=
CRON_SECRET=
JACK_SCHEDULE_WORKSPACE_ID=
JACK_EMAIL_WORKSPACE_ID=
RECORD_DELETE_SECRET=

# Optional invoice/provider sandbox. Fiat payouts are external sandbox only.
PAYOUT_PROVIDER=internal_sandbox
WISE_SANDBOX_BASE_URL=https://api.wise-sandbox.com
WISE_SANDBOX_TOKEN=
WISE_PROFILE_ID=
WISE_RECIPIENT_ACCOUNT_ID=
WISE_BALANCE_ID=
WISE_AUTO_FUND=false
PAYOUT_SINGLE_LIMIT_USD=
PAYOUT_ALLOWED_CURRENCIES=USD,GBP,EUR,CNY,INR,NGN
PAYOUT_BLOCKED_COUNTRIES=
PAYOUT_REQUIRE_KYB=false
BUSINESS_KYB_STATUS=not_configured

# Channels — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_REVIEW_SECRET=
WECHAT_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Native AMA x402 is disabled until a verified native facilitator exists.
# The V3 release must not configure any Celo/ERC20/x402 production keys.
