# 33JACK V3 — M1 isolated Amadeus Layer-1 Testnet.
# Native AMA only. No mainnet RPC, no EVM/Celo/Solana chain configuration.
# This file has no credentials. Put any required values into scoped preview
# environment variables only and never commit secrets.
AMA_TESTNET_RPC_URL=https://testnet-rpc.ama.one/api
AMA_TESTNET_MAX_TRANSFER=100

# M1 has no active DB-backed payment processing or background payouts.
# Never reuse V2 production databases, signers, or provider credentials in V3.
# Future milestone configuration will be introduced with isolated test-only credentials.

# M2/M3: a dedicated, non-production V3 PostgreSQL database.
# Never reuse V2 production keys, schema, wallets or payment connections.
DATABASE_URL=
# M3 has no active on-chain transfer submission. Broadcast is reserved for M4.

# M4 broadcast disabled by default; leave false unless official Testnet wallet
# and funded two-wallet acceptance were independently witnessed.
AMA_M4_ENABLE_BROADCAST=false
AMA_M4_WALLET_EXTENSION_VERIFIED=false
AMA_M4_TWO_WALLET_ACCEPTANCE_VERIFIED=false

# M5 optional explanation: OFF unless explicit opt-in and safe server configuration.
AMA_M5_ALLOW_REMOTE_AI=false
# GROQ_API_KEY is server-side only, never a VITE_ frontend variable.

# M6: invoice sources capped at 2 MiB, PDF extraction capped at 8 pages.
# All financial approval, signing, mainnet and broadcast locks remain unchanged.

# M7 financial-policy tables use the dedicated V3 non-production PostgreSQL database.
# No additional permission enables M4 chain broadcast, which remains disabled.
# KYC/KYB/AML providers are intentionally NOT INTEGRATED.

# M8 readonly native Testnet UX uses the existing V3 M2 organization session and DB.
# No new keys, FX providers, mainnet routing or broadcast-authorizing flags.

# M9: no additional runtime signing or broadcast flags. Read-only official
# Testnet RPC checks are initiated by authenticated owner/admin only.
# CI must set AMA_M4_ENABLE_BROADCAST=false, AMA_M4_WALLET_EXTENSION_VERIFIED=false
# and AMA_M4_TWO_WALLET_ACCEPTANCE_VERIFIED=false.

# M10 adds no new signing, custody, live-payout, mainnet or production flags.
# Read-only owner/admin exports use the existing M9 isolated V3 database.
# Any future Preview credentials must be configured out of source with SSO.
